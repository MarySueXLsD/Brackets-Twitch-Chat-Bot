{
  "name": "brackets-twitch-chat-bot",
  "productName": "Brackets",
  "version": "0.1.0",
  "description": "Brackets — a Twitch chat bot that answers in your own manner, with a launcher to watch it work. The FreeLLMAPI router is built in.",
  "main": "./out/main/index.js",
  "author": {
    "name": "MarySue",
    "url": "https://github.com/MarySueXLsD"
  },
  "homepage": "https://github.com/MarySueXLsD",
  "license": "MIT",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "router": "node scripts/build-router.mjs",
    "icons": "node scripts/make-icons.mjs",
    "setup": "npm run vendor && npm run router && npm run icons",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "demo": "electron-vite build && electron . --demo",
    "preview": "node scripts/make-preview.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"tests/*.test.ts\"",
    "dist": "npm run router && npm run icons && npm run build && electron-builder --win --x64",
    "dist:dir": "npm run router && npm run icons && npm run build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.540.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "zustand": "^5.0.16"
  }
}
